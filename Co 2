#include <stdio.h>

int main() {
    int questions, time, submitted;

    printf("Questions Answered: ");
    scanf("%d", &questions);

    printf("Remaining Time: ");
    scanf("%d", &time);

    printf("Already Submitted: ");
    scanf("%d", &submitted);

    if (questions >= 1 && time > 0 && submitted == 0)
        printf("Submission Allowed");
    else
        printf("Submission Not Allowed");

    return 0;
}
