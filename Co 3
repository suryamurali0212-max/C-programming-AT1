#include <stdio.h>

int main() {
    int gold, x, y, ben, blackbeard, pirates;

    scanf("%d%d%d", &gold, &x, &y);

    ben = gold * x / 100;
    gold = gold - ben;

    blackbeard = gold * y / 100;
    gold = gold - blackbeard;

    pirates = gold / 3;

    printf("%d\n%d\n%d", ben, blackbeard, pirates);

    return 0;
}
